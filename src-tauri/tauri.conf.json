{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dungeons And Dynasties - Save Editor",
  "mainBinaryName": "dndeditor",
  "version": "1.1.0",
  "identifier": "com.nismara.dndsaveeditor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dungeons And Dynasties - Save Editor",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMDcwNUNDN0Y0RTM1NkQKUldSdE5VNS96QVVIZmhacEx3a0hXWW5rcGdFcXRpdlZmM1d1QjV3RFk4VFlsRUkzVUhtak1SVmwK",
      "endpoints": [
        "https://github.com/mhazm/strawberry-sweet-candy/releases/latest/download/latest.json"
      ]
    }
  }
}